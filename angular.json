{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "Gym-Center-Front": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/gym-center-front",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/custom-theme.scss",
              "src/assets/css/owl.carousel.min.css",
              "src/assets/css/slicknav.css",
              "src/assets/css/flaticon.css",
              "src/assets/css/gijgo.css",
              "src/assets/css/animate.min.css",
              "src/assets/css/animated-headline.css",
              "src/assets/css/magnific-popup.css",
              "src/assets/css/fontawesome-all.min.css",
              "src/assets/css/themify-icons.css",
              "src/assets/css/slick.css",
              "src/assets/css/nice-select.css",
              "src/styles.css",
              "node_modules/bootstrap/dist/css/bootstrap.min.css"
            ],
            "scripts": [
              "node_modules/bootstrap/dist/js/bootstrap.js",
              "src/assets/js/vendor/modernizr-3.5.0.min.js",
              "src/assets/js/vendor/jquery-1.12.4.min.js",
              "src/assets/js/popper.min.js",
              "src/assets/js/bootstrap.min.js",
              "src/assets/js/jquery.slicknav.min.js",
              "src/assets/js/owl.carousel.min.js",
              "src/assets/js/slick.min.js",
              "src/assets/js/wow.min.js",
              "src/assets/js/animated.headline.js",
              "src/assets/js/jquery.magnific-popup.js",
              "src/assets/js/gijgo.min.js",
              "src/assets/js/jquery.nice-select.min.js",
              "src/assets/js/jquery.sticky.js",
              "src/assets/js/jquery.counterup.min.js",
              "src/assets/js/waypoints.min.js",
              "src/assets/js/jquery.countdown.min.js",
              "src/assets/js/hover-direction-snake.min.js",
              "src/assets/js/contact.js",
              "src/assets/js/jquery.form.js",
              "src/assets/js/jquery.validate.min.js",
              "src/assets/js/mail-script.js",
              "src/assets/js/jquery.ajaxchimp.min.js",
              "src/assets/js/plugins.js",
              "src/assets/js/main.js"
            ],
            "server": "src/main.server.ts",
            "prerender": true,
            "ssr": {
              "entry": "server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "10mb",
                  "maximumError": "10mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kb",
                  "maximumError": "10kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "Gym-Center-Front:build:production"
            },
            "development": {
              "buildTarget": "Gym-Center-Front:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4500
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "Gym-Center-Front:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/ngx-owl-carousel-o/lib/styles/prebuilt-themes/owl.carousel.min.css",
              "node_modules/ngx-owl-carousel-o/lib/styles/prebuilt-themes/owl.theme.default.min.css",
              "src/styles.css",
              "node_modules/angular-calendar/css/angular-calendar.css"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
